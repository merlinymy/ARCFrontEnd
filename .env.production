# Intentionally left unset.
#
# src/services/api.ts falls back to '/api', which `vite preview` proxies to
# the backend on localhost:8001 (see vite.config.ts). The browser therefore
# talks to a single origin: no CORS, and nothing to rebuild when the
# Cloudflare quick tunnel hands out a new URL.
#
# This previously pinned a specific trycloudflare.com hostname, which stopped
# working the moment that tunnel was restarted.
#
# Set this ONLY if the API is genuinely served from another origin, and
# remember that the backend's CORS_ORIGINS must then list this app's origin.
# VITE_API_BASE_URL=
